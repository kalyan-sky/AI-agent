# Copy to terraform.tfvars (git-ignored — see repo root .gitignore) and
# fill in real values. Never commit terraform.tfvars.

project_id = "your-gcp-project-id"
region     = "us-central1" # must be us-central1, us-east1, or us-west1 for e2-micro Always Free

environment = "staging"

github_repository = "kalyan-sky/ai-agent"

# Left blank until the Artifact Registry repo exists and an image has
# been pushed once (see README's bootstrap order) — Cloud Run falls back
# to a placeholder "hello" image until then.
agent_service_image   = ""
mock_enterprise_image = ""

# Optional — leave blank to skip the budget alert entirely.
billing_account_id       = ""
alert_notification_email = ""
monthly_budget_usd       = 10
