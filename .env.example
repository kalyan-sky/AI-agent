# ==============================================================================
# Enterprise AI Operations Agent Platform — environment configuration template
# Copy to .env and fill in real values. Never commit .env.
# ==============================================================================

# --- General -----------------------------------------------------------------
ENVIRONMENT=local                 # local | dev | staging | prod
LOG_LEVEL=INFO
SERVICE_NAME=agent-service

# --- Agent API -----------------------------------------------------------------
AGENT_API_HOST=0.0.0.0
AGENT_API_PORT=8000
API_KEYS=local-dev-key-viewer:viewer,local-dev-key-operator:operator,local-dev-key-admin:admin
JWT_SECRET_KEY=change-me-in-real-deployments
JWT_ALGORITHM=HS256
JWT_ISSUER=ai-ops-agent
OAUTH_TOKEN_URL=                  # set for OAuth2 client-credentials flow, optional

# --- LLM provider (provider-agnostic; primary + optional fallback) -----------
# Cheapest-first default: Claude Haiku 4.5 ($1/$5 per MTok input/output — the
# cheapest current Claude model) as primary. Set LLM_FALLBACK_PROVIDER to add
# a fallback used only if the primary fails after its own retries (see
# app/agent/llm_provider.py's FallbackLLM). Gemini's free tier (check
# ai.google.dev/gemini-api/docs/pricing for current terms/model IDs) is a
# reasonable $0 fallback/secondary choice; OpenRouter is OpenAI-compatible —
# use provider=openai with OPENAI_BASE_URL=https://openrouter.ai/api/v1 and
# OPENAI_API_KEY=<your OpenRouter key> to route through it instead.
LLM_PROVIDER=anthropic            # anthropic | openai | gemini
LLM_MODEL=claude-haiku-4-5
LLM_FALLBACK_PROVIDER=            # anthropic | openai | gemini | "" (none)
LLM_FALLBACK_MODEL=               # e.g. a Gemini free-tier model ID
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GOOGLE_API_KEY=
LLM_REQUEST_TIMEOUT_S=30
LLM_MAX_RETRIES=2

# --- Embeddings (Hugging Face) -------------------------------------------------
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
HUGGINGFACE_API_TOKEN=

# --- Vector DB (Qdrant) --------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_knowledge
QDRANT_LOCAL_PATH=                # set for embedded/local-mode Qdrant (sandbox/dev only)
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100

# --- Database (PostgreSQL) ------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aiops
POSTGRES_USER=aiops
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://aiops:change-me@postgres:5432/aiops

# --- Cache (Redis) ---------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Mock enterprise API ----------------------------------------------------------
MOCK_ENTERPRISE_BASE_URL=http://mock-enterprise:9000
MOCK_ENTERPRISE_TIMEOUT_S=10

# --- n8n --------------------------------------------------------------------------
N8N_HOST=n8n
N8N_PORT=5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me
N8N_WEBHOOK_URL=http://localhost:5678/
AGENT_API_INTERNAL_URL=http://agent-service:8000

# --- Agent execution limits ---------------------------------------------------------
AGENT_MAX_ITERATIONS=8
AGENT_TIMEOUT_S=90
AGENT_MIN_CONFIDENCE=0.4

# --- Failure injection (demo/testing only; never set true in prod) -----------------
FAILURE_INJECTION_ENABLED=false
FAILURE_INJECTION_TARGET=        # llm_timeout|qdrant_down|postgres_down|enterprise_timeout|enterprise_500

# --- GCP (used by Terraform / deploy scripts, not by the app directly) -------------
GCP_PROJECT_ID=
GCP_REGION=us-central1
