{
  "name": "Error Handling",
  "nodes": [
    {
      "parameters": {},
      "id": "54ee20e1-6d14-46ca-83f2-28eea4c5c942",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const err = $input.first().json;\nconst transient = /timeout|ECONNRESET|ETIMEDOUT|503|502|429/i.test(\n  JSON.stringify(err.execution?.error ?? err)\n);\nreturn [{ json: { ...err, retryable: transient } }];"
      },
      "id": "221fa13c-ab70-4cc0-aa75-15dd2d7252b2",
      "name": "Log Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.retryable }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "77b96a20-8584-4fdd-a83d-0bbd4b5d2861",
      "name": "Retryable?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "id": "f4ecfce0-8b67-49da-8f71-6b6bf7516a48",
      "name": "Backoff Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "={{ $json.workflow.id }}",
          "mode": "id"
        },
        "options": {}
      },
      "id": "f6d7d2bf-cb61-44fe-9950-90909de21458",
      "name": "Retry Workflow",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1120,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MOCK_ENTERPRISE_BASE_URL }}/incidents",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"title\": 'n8n workflow failure: ' + $json.workflow.name, \"description\": JSON.stringify($json.execution?.error ?? {}), \"severity\": \"high\" } }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "a8edad63-c92f-4c0d-a615-671bfa132c05",
      "name": "Create Incident",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        420
      ]
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Log Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Error": {
      "main": [
        [
          {
            "node": "Retryable?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Retryable?": {
      "main": [
        [
          {
            "node": "Backoff Wait",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Create Incident",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Backoff Wait": {
      "main": [
        [
          {
            "node": "Retry Workflow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "50d2d886-f4c6-4e23-9af2-b5db3ee5acb0",
  "tags": [
    "ai-ops-agent"
  ]
}
