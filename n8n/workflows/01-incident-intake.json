        "language": "javaScript",
        "jsCode": "const body = $input.first().json.body ?? {};\nconst required = ['conversation_id', 'user_id', 'message'];\nconst missing = required.filter((f) => !body[f] || String(body[f]).trim() === '');\nif (missing.length > 0) {\n  throw new Error(`Missing required field(s): ${missing.join(', ')}`);\n}\nreturn [{ json: body }];"
      },
