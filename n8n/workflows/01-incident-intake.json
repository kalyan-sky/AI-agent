        "jsCode": "const expected = $env.N8N_INCIDENT_INTAKE_SECRET;\nconst provided = $input.first().json.headers['x-webhook-secret'];\nif (!expected || provided !== expected) {\n  throw new Error('Unauthorized: missing or invalid X-Webhook-Secret header');\n}\nreturn $input.all();"
      },
