        300
      ],
      "credentials": {
        "aiOpsAgentApi": {
          "id": "1",
          "name": "AI-Ops Agent API"
        }
      }
    },
    {
      "parameters": {
        "conversationId": "={{ $('Webhook').item.json.body.conversation_id }}",
        "userId": "={{ $('Webhook').item.json.body.user_id }}",
