{
  "name": "n8n-nodes-aiops-agent",
  "version": "0.1.0",
  "description": "n8n community node for the AI-Ops Agent Platform's agent-service API",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "author": {
    "name": "AI-Ops Agent Platform"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/AiOpsAgentApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/AiAgentExecute/AiAgentExecute.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
