# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
.venv-*/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.coverage
htmlcov/

# Node
node_modules/
dist/
npm-debug.log*

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
terraform.tfvars
!terraform.tfvars.example

# Terraform
infrastructure/terraform/.terraform/
infrastructure/terraform/*.tfstate
infrastructure/terraform/*.tfstate.*
infrastructure/terraform/tfplan
# .terraform.lock.hcl is deliberately NOT ignored — committing it pins
# provider versions so `terraform init` is reproducible in CI and for
# every other contributor, per Terraform's own recommendation.

